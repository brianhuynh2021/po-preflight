# ============================================================================
# PO Preflight — Production Environment Configuration Template
# Copy this file to .env and configure secrets accordingly.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Server & Security Gateway
# ----------------------------------------------------------------------------
PORT=8001
HOST=0.0.0.0
PREFLIGHT_AUTH_REQUIRED=false
PREFLIGHT_ADMIN_KEY=pf_live_adm_9901
PREFLIGHT_MANAGER_KEY=pf_live_mgr_8802
PREFLIGHT_AUDITOR_KEY=pf_live_aud_7703
PREFLIGHT_VIEWER_KEY=pf_live_view_6604

# ----------------------------------------------------------------------------
# 2. Database & Persistent Storage (Dual-Backend: SQLite / PostgreSQL)
# ----------------------------------------------------------------------------
DATABASE_URL=sqlite:///runtime/preflight.db
# DATABASE_URL=postgresql://user:password@localhost:5432/preflight
PREFLIGHT_DB_PATH=runtime/preflight.db
CATALOG_PATH=examples/catalog.csv

# ----------------------------------------------------------------------------
# 3. Multimodal Vision OCR & AI Models
# ----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ----------------------------------------------------------------------------
# 4. Multi-Channel Approval Bots (Telegram & Zalo OA)
# ----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_DRY_RUN=true

ZALO_OA_ACCESS_TOKEN=
ZALO_RECIPIENT_USER_ID=
ZALO_DRY_RUN=true

# ----------------------------------------------------------------------------
# 5. ERP Connectors (SAP / Odoo)
# ----------------------------------------------------------------------------
ERP_DEFAULT_ADAPTER=MOCK_SAP
ERP_SYNC_AUTO=true
